{
  "author": "kzero",
  "bugs": "https://github.com/kzero-xyz/kzero-wallet/issues",
  "contributors": [],
  "description": "kzero zk core",
  "homepage": "https://github.com/kzero-xyz/kzero-wallet/tree/master/packages/zk-core#readme",
  "license": "GPL-3.0",
  "maintainers": [],
  "name": "@kzero/zk-core",
  "repository": {
    "directory": "packages/zk-core",
    "type": "git",
    "url": "https://github.com/kzero-xyz/kzero-wallet.git"
  },
  "sideEffects": false,
  "type": "module",
  "version": "0.0.0",
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "kzero",
    "zero-knowledge",
    "wallet",
    "zk-proof",
    "typescript",
    "polkadot"
  ],
  "exports": {
    ".": {
      "@kzero/source": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./constants": {
      "@kzero/source": "./src/constants.ts",
      "import": "./dist/constants.js",
      "types": "./dist/constants.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.app.json",
    "check-types": "tsc -b --noEmit",
    "dev": "tsc -p tsconfig.app.json --watch",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@polkadot/util": "^13.5.8"
  },
  "devDependencies": {
    "@types/node": "^24.10.0"
  }
}
