{
  "author": "kzero",
  "bugs": "https://github.com/kzero-xyz/kzero-wallet/issues",
  "contributors": [],
  "description": "React components, hooks, and providers for Kzero Zero-Knowledge wallet",
  "homepage": "https://github.com/kzero-xyz/kzero-wallet/tree/master/packages/zk-react#readme",
  "license": "GPL-3.0",
  "maintainers": [],
  "name": "@kzero/zk-react",
  "repository": {
    "directory": "packages/zk-react",
    "type": "git",
    "url": "https://github.com/kzero-xyz/kzero-wallet.git"
  },
  "sideEffects": [
    "*.css",
    "dist/style.css"
  ],
  "type": "module",
  "version": "0.0.0",
  "main": "index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "kzero",
    "zero-knowledge",
    "wallet",
    "react",
    "hooks",
    "components",
    "polkadot",
    "typescript"
  ],
  "exports": {
    ".": {
      "@kzero/source": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "rollup -c",
    "check-types": "tsc -b --noEmit",
    "build:tsc": "tsc -p tsconfig.app.json",
    "dev": "rollup -c --watch",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:cov": "vitest run --coverage"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-dom": ">=17"
  },
  "dependencies": {
    "@kzero/message-port": "workspace:*",
    "@kzero/zk-core": "workspace:*"
  },
  "devDependencies": {
    "@kzero/dev": "workspace:*",
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.4",
    "@rollup/plugin-url": "^8.0.2",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "rollup": "^4.52.2",
    "rollup-plugin-dts": "^6.2.3",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-postcss": "^4.0.2",
    "tslib": "^2.8.1"
  }
}
