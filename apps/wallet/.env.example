# Wallet Application Environment Variables

# Blockchain RPC Endpoint
# WebSocket endpoint for connecting to Polkadot blockchain
# If using the local chain, please replace here with your actual port
# VITE_WS_ENDPOINT=ws://127.0.0.1:9944
VITE_WS_ENDPOINT=wss://node-template.kzero.xyz

# Authentication Service Endpoint
# Backend service for OAuth and ZK proof generation
VITE_AUTH_ENDPOINT=http://localhost:3000
