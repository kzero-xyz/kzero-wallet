{
  "author": "kzero",
  "bugs": "https://github.com/kzero-xyz/kzero-wallet/issues",
  "engines": {
    "node": ">=20"
  },
  "homepage": "/",
  "license": "GPL-3.0",
  "name": "kzero-wallet",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/kzero-xyz/kzero-wallet.git"
  },
  "sideEffects": false,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "lint": "eslint --cache",
    "build": "turbo run build --concurrency=100",
    "check-types": "turbo run check-types --concurrency=100",
    "dev": "turbo run dev --filter='./packages/*' --concurrency=100",
    "dev:playground": "pnpm --filter='@kzero/playground' dev --port=5175",
    "dev:wallet": "pnpm --filter='@kzero/wallet' dev --port=5176",
    "dev:all": "pnpm run dev & pnpm run dev:wallet & pnpm run dev:playground",
    "test": "turbo run test --concurrency=100",
    "test:cov": "turbo run test:cov --concurrency=100",
    "commit": "cz",
    "postinstall": "husky"
  },
  "devDependencies": {
    "@kzero/dev": "workspace:^",
    "@vitest/coverage-v8": "^4.0.8",
    "@vitest/ui": "^4.0.8",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.39.1",
    "glob": "^11.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5",
    "npm-run-all2": "^8.0.4",
    "release-please": "^17.1.2",
    "tsx": "^4.20.4",
    "turbo": "^2.5.6",
    "typescript": "5.9.2",
    "vitest": "^4.0.8"
  },
  "packageManager": "pnpm@10.17.1+sha512.17c560fca4867ae9473a3899ad84a88334914f379be46d455cbf92e5cf4b39d34985d452d2583baf19967fa76cb5c17bc9e245529d0b98745721aa7200ecaf7a"
}
